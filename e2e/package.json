{
  "name": "fdp-client-e2e-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright UI simulation tests for the STAGE FAIR Data Point client",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --project=smoke",
