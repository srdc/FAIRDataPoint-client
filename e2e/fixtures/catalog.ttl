@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix cv:   <http://data.europa.eu/m8g/> .

# Minimal Catalog that satisfies the FDP Catalog + Resource shapes.
# {{...}} placeholders are filled in by the tests.
<{{SUBJECT}}> a dcat:Catalog ;
    dct:title "{{TITLE}}"@en ;
    dct:description "{{DESCRIPTION}}"@en ;
    <http://data.europa.eu/r5r/applicableLegislation> <http://data.europa.eu/eli/reg/2025/327/oj> ;
    dct:publisher [
        a foaf:Agent ;
        foaf:name "STAGE E2E tests" ;
        cv:contactPoint [ a cv:ContactPoint ; cv:email "e2e-tests@example.org" ]
    ] ;
    dct:isPartOf <{{PARENT}}> .

<http://data.europa.eu/eli/reg/2025/327/oj> a <http://data.europa.eu/eli/ontology#LegalResource> .
